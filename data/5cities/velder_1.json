 {
  "id": "17990926",
  "elder": "가능",
  "elder_quote": "올라오는 길은 완만했습니다",
  "elder_note": "전망대까지 오르는 길이 완만하고 쉬어갈 벤치가 있음",
  "visual": "부분",
  "visual_quote": "음성해설, 문자·수어 통역 전면 지원",
  "visual_note": "이곳 행사에서 음성해설이 제공됨(특정 공연 한정)"
 },
 {
