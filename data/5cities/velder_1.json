 {
  "id": "12729021",
  "elder": "부분",
  "elder_quote": "시설로는 유모차, 휠체어, 돋보기, 보청기",
  "elder_note": "휠체어 이용 시설은 있으나 지하도 진입 시 계단 이용 서술",
  "visual": "가능",
  "visual_quote": "돋보기, 보청기, 점자리플렛, 수화동영상",
  "visual_note": "점자 리플렛이 비치되어 있고 안내견 출입도 허용됨"
 },
