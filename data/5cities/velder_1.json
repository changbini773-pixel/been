  "id": "12644071",
  "elder": "가능",
  "elder_quote": "휠체어 이용 가능(무장애 통로 및 출입구 완비)",
  "elder_note": "무장애 통로와 출입구가 갖춰져 휠체어 이용이 가능함",
  "visual": "가능",
  "visual_quote": "안내견 등 보조견 동반 가능",
  "visual_note": "안내견 등 보조견과 함께 방문할 수 있다고 안내됨"
 },
